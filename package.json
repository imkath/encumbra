{
  "name": "encumbra-v2",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/vendor-maplibre.mjs && next dev",
    "build": "node scripts/vendor-maplibre.mjs && next build --webpack",
    "test": "node --test test/*.test.ts",
    "check": "pnpm test && pnpm lint && pnpm build",
    "start": "next start",
    "lint": "eslint",
    "dev:check": "node scripts/vendor-maplibre.mjs && NEXT_DIST_DIR=.next-check next dev --webpack -p 3005",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "indexnow": "node scripts/submit-indexnow.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "maplibre-gl": "^6.7.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.12",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.2",
    "typescript": "^5",
    "wrangler": "^4.151.1"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.7",
      "browserslist": "4.29.0",
      "sharp": ">=0.35.5",
      "source-map-js": ">=1.2.2"
    }
  }
}
